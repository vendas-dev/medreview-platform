'use client'
import { useState, useCallback, useEffect, useMemo, useRef } from 'react'
import { Target, ChevronLeft, ChevronRight, Save, Check, Loader2, Search, LayoutList, LayoutGrid, Copy, RotateCcw, AlertTriangle } from 'lucide-react'
import { createClient } from '@/lib/supabase/client'

const VERTICALS_R1  = ['Med-Review R1']
const VERTICALS_OAO = ['Anest-Review', 'Oft-Review', 'Ortop-Review']
const ALL_VERTICALS = ['Anest-Review', 'Oft-Review', 'Ortop-Review', 'Med-Review R1']
const TEAM_COLOR: Record<string, { bg: string; fg: string; edge: string }> = {
  R1:  { bg: 'rgba(124,58,237,.12)', fg: '#7c3aed', edge: '#7c3aed' },
  OAO: { bg: 'rgba(37,99,235,.12)',  fg: '#2563eb', edge: '#2563eb' },
}
const VERT_SHORT: Record<string, string> = { 'Anest-Review': 'Anest', 'Oft-Review': 'Oft', 'Ortop-Review': 'Ortop', 'Med-Review R1': 'Med R1' }

// ── Máscara BRL ────────────────────────────────────────────
function maskBRL(raw: string): string {
  const digits = raw.replace(/\D/g, '')
  if (!digits) return ''
  const num = parseInt(digits, 10) / 100
  return num.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 })
}
function parseBRL(v: string): number {
  return parseFloat(v.replace(/[^\d,]/g, '').replace(',', '.')) || 0
}
const fmtBRL = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 })
const fmtShort = (n: number) => n >= 1e6 ? `R$ ${(n / 1e6).toFixed(2).replace('.', ',')} mi` : fmtBRL(n)

// ── Campo de dinheiro: acompanha o valor de fora (repetir mês, descartar) e navega com Enter/setas ──
function MoneyField({ value, onChange, cell, label, onNav, dirty = false, disabled = false }: { value: number; onChange: (v: number) => void; cell?: string; label?: string; onNav?: (dir: -1 | 1) => void; dirty?: boolean; disabled?: boolean }) {
  const [display, setDisplay] = useState(value > 0 ? maskBRL((value * 100).toFixed(0)) : '')
  const [focused, setFocused] = useState(false)
  useEffect(() => { if (!focused) setDisplay(value > 0 ? maskBRL(Math.round(value * 100).toString()) : '') }, [value, focused])
  return (
    <input type="text" inputMode="numeric" className="gm-field" data-dirty={dirty ? '1' : '0'} data-cell={cell} aria-label={label} disabled={disabled}
      value={display} placeholder="R$ 0,00"
      onChange={e => { const m = maskBRL(e.target.value); setDisplay(m); onChange(parseBRL(m)) }}
      onFocus={e => { setFocused(true); e.target.select() }} onBlur={() => setFocused(false)}
      onKeyDown={e => { if (e.key === 'Enter' || e.key === 'ArrowDown') { e.preventDefault(); onNav?.(1) } else if (e.key === 'ArrowUp') { e.preventDefault(); onNav?.(-1) } }} />
  )
}

function Avatar({ name, url, size = 40 }: { name: string; url?: string | null; size?: number }) {
  const [bad, setBad] = useState(false)
  const ini = (name || '?').split(' ').filter(Boolean).slice(0, 2).map(n => n[0]).join('').toUpperCase() || '?'
  if (url && !bad) return <img src={url} alt={name} onError={() => setBad(true)} data-avatar="img" style={{ width: size, height: size, borderRadius: '50%', objectFit: 'cover', flexShrink: 0, boxShadow: '0 0 0 2px var(--card), 0 0 0 3.5px var(--border)' }} />
  return <div data-avatar="ini" style={{ width: size, height: size, borderRadius: '50%', background: 'linear-gradient(135deg,#4f46e5,#7c3aed)', color: '#fff', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: size * 0.36, fontWeight: 800, flexShrink: 0 }}>{ini}</div>
}

// ── Rascunho de um closer (o que está na tela) × base (o que está salvo) ──
type Draft = { goalSales: number; goalAmbassador: number; byV: Record<string, number> }
const toDraft = (c: any): Draft => ({ goalSales: Number(c.goal?.goal_sales) || 0, goalAmbassador: Number(c.goal?.goal_ambassador) || 0, byV: Object.fromEntries(Object.entries(c.goal?.goals_by_vertical ?? {}).map(([k, v]) => [k, Number(v) || 0])) })
const buildAll = (list: any[]) => Object.fromEntries(list.map(c => [c.id, toDraft(c)])) as Record<string, Draft>
const same = (a: Draft, b: Draft) => a.goalSales === b.goalSales && a.goalAmbassador === b.goalAmbassador && ALL_VERTICALS.every(v => (a.byV[v] || 0) === (b.byV[v] || 0))
const verticalsOf = (team: string | null | undefined) => (team === 'R1' ? VERTICALS_R1 : team === 'OAO' ? VERTICALS_OAO : [])
const hiddenByFlag = (c: any) => c.is_active === false || !!c.deleted_at || c.status === 'inactive' || c.status === 'deleted'

type RowSt = { status: 'saving' | 'saved' | 'error'; msg?: string }

// ── Painel de Meta Geral / Metas por Vertical — salvos juntos numa
// requisição só, cada aba com seu próprio botão de salvar. Depois de salvar,
// busca de novo no banco (não confia só no estado local) — assim o usuário
// vê a confirmação real de que persistiu, não só um "Salvo!" otimista.
function CompanyGoalsPanel({ mode, month, initialGoals }: { mode: 'geral' | 'vertical'; month: string; initialGoals: Record<string, number> }) {
  const [geral, setGeral] = useState<number>(Number(initialGoals['geral']) || 0)
  const [byVertical, setByVertical] = useState<Record<string, number>>(Object.fromEntries(ALL_VERTICALS.map(v => [v, Number(initialGoals[v]) || 0])))
  const [saving, setSaving] = useState(false)
  const [saved,  setSaved]  = useState(false)
  const [error,  setError]  = useState('')
  const [confirmedAt, setConfirmedAt] = useState<string | null>(null)

  async function handleSave() {
    setSaving(true); setError(''); setSaved(false)
    try {
      const goals = mode === 'geral' ? { geral } : { ...byVertical }
      const res = await fetch('/api/intel/company-goals', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ month, goals }) })
      const data = await res.json().catch(() => ({}))
      if (!res.ok) { setError(data.error ?? 'Erro ao salvar'); return }
      const check = await fetch(`/api/intel/company-goals?month=${month}`)
      const checkData = await check.json().catch(() => ({ goals: {} }))
      const persisted = mode === 'geral' ? Number(checkData.goals?.geral) === geral : ALL_VERTICALS.every(v => Number(checkData.goals?.[v] ?? 0) === (byVertical[v] ?? 0))
      if (!persisted) { setError('Salvou, mas a confirmação não bateu — tenta recarregar a página pra checar.'); return }
      setSaved(true)
      setConfirmedAt(new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }))
      setTimeout(() => setSaved(false), 3000)
    } catch { setError('Erro de conexão') } finally { setSaving(false) }
  }

  const isGeral = mode === 'geral'
  const grad = isGeral ? 'linear-gradient(135deg,#0f766e 0%,#0d9488 55%,#16a34a 100%)' : 'linear-gradient(135deg,#7c2d12 0%,#c2410c 55%,#f59e0b 100%)'
  const headline = isGeral ? '🎯 Qual é o norte da empresa esse mês?' : '📊 Onde cada vertical precisa chegar'
  const subline = isGeral
    ? 'Essa é a meta que todo o time olha — alimenta o "Meta x Realizado" e o forecast de fechamento do mês.'
    : 'Cada vertical com sua própria meta — alimenta qualquer análise que compare uma vertical específica no sistema.'
  return (
    <div data-v="company-panel" style={{ borderRadius: 20, overflow: 'hidden', maxWidth: 560, boxShadow: '0 12px 32px rgba(0,0,0,.14)' }}>
      <div style={{ background: grad, padding: '24px 26px', position: 'relative', overflow: 'hidden' }}>
        <div style={{ position: 'absolute', top: -30, right: -30, width: 150, height: 150, borderRadius: '50%', background: 'rgba(255,255,255,0.1)' }} />
        <p style={{ fontSize: 16, fontWeight: 900, color: '#fff', margin: '0 0 6px', letterSpacing: '-0.01em', position: 'relative', zIndex: 1 }}>{headline}</p>
        <p style={{ fontSize: 12.5, color: 'rgba(255,255,255,0.85)', margin: 0, lineHeight: 1.5, position: 'relative', zIndex: 1 }}>{subline}</p>
      </div>
      <div style={{ background: 'var(--card)', border: '1px solid var(--border)', borderTop: 'none', padding: '22px 26px', display: 'flex', flexDirection: 'column', gap: 16 }}>
        {error && <p data-v="company-error" style={{ margin: 0, fontSize: 12, color: '#ef4444', padding: '9px 12px', background: 'rgba(239,68,68,.08)', border: '1px solid rgba(239,68,68,.25)', borderRadius: 10 }}>⚠ {error}</p>}
        {isGeral ? (
          <div>
            <label className="gm-label">Meta do mês (empresa)</label>
            <MoneyField value={geral} onChange={setGeral} label="Meta do mês (empresa)" cell="geral" />
          </div>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            {ALL_VERTICALS.map(v => (
              <div key={v} style={{ display: 'grid', gridTemplateColumns: '1fr 1.3fr', alignItems: 'center', gap: 12 }}>
                <span style={{ fontSize: 13, fontWeight: 700, color: 'var(--foreground)' }}>{v}</span>
                <MoneyField value={byVertical[v] ?? 0} onChange={val => setByVertical(prev => ({ ...prev, [v]: val }))} label={v} cell={v} />
              </div>
            ))}
          </div>
        )}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12 }}>
          <span style={{ fontSize: 11, color: 'var(--muted-foreground)' }}>{confirmedAt ? `✅ Confirmado no banco às ${confirmedAt}` : 'Ainda não salvo esse mês'}</span>
          <button onClick={handleSave} disabled={saving} data-v="company-save" className="gm-btn" style={{ background: saved ? '#22c55e' : grad, color: '#fff', border: 'none' }}>
            {saving ? <Loader2 size={13} className="gm-spin" /> : saved ? <Check size={13} /> : <Save size={13} />}
            {saving ? 'Salvando...' : saved ? 'Confirmado!' : 'Salvar meta'}
          </button>
        </div>
      </div>
    </div>
  )
}

// ── GoalsManager ────────────────────────────────────────────
export function GoalsManager({ closers: initialClosers, month: initialMonth, companyGoals: initialCompanyGoals }: { closers: any[]; month: string; companyGoals: Record<string, number> }) {
  const [currentMonth, setCurrentMonth] = useState(initialMonth)
  const [closers, setClosers] = useState<any[]>(initialClosers)
  const [companyGoals, setCompanyGoals] = useState(initialCompanyGoals)
  const [loadingMonth, setLoadingMonth] = useState(false)
  const [filterTeam, setFilterTeam] = useState<'todos' | 'R1' | 'OAO'>('todos')
  const [tab, setTab] = useState<'closers' | 'geral' | 'vertical'>('closers')
  const [view, setView] = useState<'lista' | 'cards'>('lista')
  const [query, setQuery] = useState('')
  const [base, setBase] = useState<Record<string, Draft>>(() => buildAll(initialClosers))
  const [drafts, setDrafts] = useState<Record<string, Draft>>(() => buildAll(initialClosers))
  const [rows, setRows] = useState<Record<string, RowSt>>({})
  const [bulk, setBulk] = useState(false)
  const [notice, setNotice] = useState('')
  // foto e situação vêm DIRETO de profiles: inativo ou excluído (que não existe mais) nunca aparece — nem ao trocar de mês
  const [info, setInfo] = useState<Record<string, { avatar_url: string | null; is_active: boolean | null }>>({})
  const [queried, setQueried] = useState<Set<string>>(new Set())
  const [infoFailed, setInfoFailed] = useState(false)
  const timers = useRef<number[]>([])
  useEffect(() => () => { timers.current.forEach(t => clearTimeout(t)) }, [])

  useEffect(() => {
    const faltam = closers.map(c => c.id).filter(id => !queried.has(id))
    if (faltam.length === 0) return
    let off = false
    ;(async () => {
      try {
        const supabase = createClient()
        const { data, error } = await supabase.from('profiles').select('id, avatar_url, is_active').in('id', faltam)
        if (off) return
        if (error || !data) { setInfoFailed(true); setQueried(prev => new Set([...prev, ...faltam])); return }
        setInfo(prev => ({ ...prev, ...Object.fromEntries((data as any[]).map(p => [p.id, { avatar_url: p.avatar_url ?? null, is_active: p.is_active ?? null }])) }))
        setQueried(prev => new Set([...prev, ...faltam]))
      } catch { if (!off) { setInfoFailed(true); setQueried(prev => new Set([...prev, ...faltam])) } }
    })()
    return () => { off = true }
  }, [closers, queried])

  const infoReady = closers.every(c => queried.has(c.id))
  const visible = useMemo(() => closers.filter(c => {
    if (hiddenByFlag(c)) return false
    if (!infoFailed && queried.has(c.id) && !info[c.id]) return false          // não existe mais em profiles = excluído
    if (info[c.id]?.is_active === false) return false
    return true
  }).sort((a, b) => String(a.name).localeCompare(String(b.name), 'pt-BR')), [closers, info, queried, infoFailed])
  const hiddenCount = closers.length - visible.length

  const q = query.trim().toLowerCase()
  const filtered = visible.filter(c => (filterTeam === 'todos' || c.team === filterTeam) && (!q || String(c.name).toLowerCase().includes(q)))
  const countTeam = (t: string) => visible.filter(c => c.team === t).length
  const dirtyIds = visible.filter(c => drafts[c.id] && base[c.id] && !same(drafts[c.id], base[c.id])).map(c => c.id)
  const [y, m] = currentMonth.split('-').map(Number)
  const monthLabel = (l => l.charAt(0).toUpperCase() + l.slice(1))(new Date(y, m - 1, 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }))

  const setDraft = (id: string, patch: (d: Draft) => Draft) => { setDrafts(prev => ({ ...prev, [id]: patch(prev[id] ?? { goalSales: 0, goalAmbassador: 0, byV: {} }) })); setRows(prev => (prev[id] ? (() => { const n = { ...prev }; delete n[id]; return n })() : prev)) }

  async function changeMonth(delta: number) {
    if (dirtyIds.length > 0 && !window.confirm(`Há ${dirtyIds.length} linha${dirtyIds.length > 1 ? 's' : ''} com alterações NÃO salvas. Trocar de mês descarta essas alterações. Continuar?`)) return
    const [cy, cm] = currentMonth.split('-').map(Number)
    const d = new Date(cy, cm - 1 + delta, 1)
    const newMonth = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
    setLoadingMonth(true)
    try {
      const [res, resCompany] = await Promise.all([fetch(`/api/intel/goals?month=${newMonth}`), fetch(`/api/intel/company-goals?month=${newMonth}`)])
      const data = await res.json()
      const dataCompany = await resCompany.json().catch(() => ({ goals: {} }))
      const list = data.closers ?? []
      setClosers(list); setBase(buildAll(list)); setDrafts(buildAll(list)); setRows({}); setNotice('')
      setCompanyGoals(dataCompany.goals ?? {})
      setCurrentMonth(newMonth)
    } catch { /* mantém o mês atual se falhar */ } finally { setLoadingMonth(false) }
  }

  async function saveOne(id: string): Promise<boolean> {
    const d = drafts[id]; if (!d) return false
    setRows(prev => ({ ...prev, [id]: { status: 'saving' } }))
    try {
      const res = await fetch('/api/intel/goals', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: id, month: currentMonth, goal_sales: d.goalSales, goal_ambassador: d.goalAmbassador, goals_by_vertical: { ...(base[id]?.byV ?? {}), ...d.byV } }) })
      const data = await res.json().catch(() => ({}))
      if (!res.ok) { setRows(prev => ({ ...prev, [id]: { status: 'error', msg: data.error ?? 'Erro ao salvar' } })); return false }
      setBase(prev => ({ ...prev, [id]: { goalSales: d.goalSales, goalAmbassador: d.goalAmbassador, byV: { ...(prev[id]?.byV ?? {}), ...d.byV } } }))
      setRows(prev => ({ ...prev, [id]: { status: 'saved' } }))
      timers.current.push(window.setTimeout(() => setRows(prev => (prev[id]?.status === 'saved' ? (() => { const n = { ...prev }; delete n[id]; return n })() : prev)), 3000))
      return true
    } catch { setRows(prev => ({ ...prev, [id]: { status: 'error', msg: 'Erro de conexão' } })); return false }
  }
  async function saveAll() {
    setBulk(true); setNotice('')
    let ok = 0, fail = 0
    for (const id of dirtyIds) { if (await saveOne(id)) ok++; else fail++ }
    setBulk(false)
    setNotice(fail === 0 ? `✅ ${ok} ${ok === 1 ? 'meta salva' : 'metas salvas'}.` : `⚠ ${ok} salva${ok === 1 ? '' : 's'}, ${fail} com erro — veja as linhas marcadas.`)
  }
  const discardAll = () => { setDrafts(prev => ({ ...prev, ...Object.fromEntries(dirtyIds.map(id => [id, base[id]])) })); setRows({}); setNotice('') }

  async function fillFromPrevious() {
    const [cy, cm] = currentMonth.split('-').map(Number); const d = new Date(cy, cm - 2, 1)
    const prev = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
    setNotice('')
    try {
      const res = await fetch(`/api/intel/goals?month=${prev}`); const data = await res.json()
      const before = Object.fromEntries(((data.closers ?? []) as any[]).map(c => [c.id, toDraft(c)])) as Record<string, Draft>
      let filled = 0
      setDrafts(cur => { const next = { ...cur }
        for (const c of visible) { const p = before[c.id], now = cur[c.id]; if (!p || !now) continue
          const nd: Draft = { goalSales: now.goalSales || p.goalSales, goalAmbassador: now.goalAmbassador || p.goalAmbassador, byV: { ...now.byV } }
          for (const v of verticalsOf(c.team)) if (!nd.byV[v]) nd.byV[v] = p.byV[v] || 0
          if (!same(nd, now)) { next[c.id] = nd; filled++ } }
        return next })
      setTimeout(() => setNotice(`Preenchi os campos vazios com os valores de ${new Date(d).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}. Confira e salve.`), 0)
    } catch { setNotice('⚠ Não consegui buscar o mês anterior.') }
  }

  const nav = (r: number, col: string, dir: -1 | 1) => { const el = document.querySelector<HTMLInputElement>(`[data-cell="${r + dir}:${col}"]`); if (el) el.focus() }
  const totals = useMemo(() => {
    const t = { goalSales: 0, goalAmbassador: 0, byV: {} as Record<string, number>, filled: 0 }
    for (const c of filtered) { const d = drafts[c.id]; if (!d) continue; t.goalSales += d.goalSales; t.goalAmbassador += d.goalAmbassador; for (const v of verticalsOf(c.team)) t.byV[v] = (t.byV[v] || 0) + (d.byV[v] || 0); if (d.goalSales > 0) t.filled++ }
    return t
  }, [filtered, drafts])

  const TABS = [{ key: 'closers' as const, label: '👥 Por Closer' }, { key: 'geral' as const, label: '🏢 Meta Geral' }, { key: 'vertical' as const, label: '📊 Metas por Vertical' }]

  const statusOf = (id: string) => rows[id]
  const SaveBtn = ({ id }: { id: string }) => { const st = statusOf(id), dirty = dirtyIds.includes(id)
    return <button className="gm-btn gm-btn-sm" data-v="row-save" disabled={!dirty || st?.status === 'saving' || bulk} onClick={() => saveOne(id)}
      style={{ background: st?.status === 'saved' ? '#22c55e' : dirty ? 'linear-gradient(135deg,#4f46e5,#7c3aed)' : 'var(--secondary)', color: dirty || st?.status === 'saved' ? '#fff' : 'var(--muted-foreground)', border: 'none', opacity: dirty || st ? 1 : 0.6 }}>
      {st?.status === 'saving' ? <Loader2 size={12} className="gm-spin" /> : st?.status === 'saved' ? <Check size={12} /> : <Save size={12} />}
      {st?.status === 'saving' ? 'Salvando' : st?.status === 'saved' ? 'Salvo' : 'Salvar'}
    </button> }

  return (
    <div className="gm" style={{ maxWidth: 1240, margin: '0 auto', padding: '28px 24px 96px', display: 'flex', flexDirection: 'column', gap: 22 }}>
      <style>{`
        .gm *{box-sizing:border-box}
        .gm-spin{animation:gmspin 1s linear infinite}@keyframes gmspin{to{transform:rotate(360deg)}}
        .gm-label{font-size:11px;font-weight:800;color:var(--muted-foreground);display:block;margin-bottom:7px;text-transform:uppercase;letter-spacing:.06em}
        .gm-field{width:100%;height:40px;padding:0 12px;border-radius:11px;border:1.5px solid var(--border);background:var(--background);color:var(--foreground);font-size:13.5px;font-family:inherit;font-variant-numeric:tabular-nums;outline:none;transition:border-color .15s,box-shadow .15s,background .15s}
        .gm-field:hover:not(:disabled){border-color:color-mix(in srgb,#6366f1 40%,var(--border))}
        .gm-field:focus{border-color:#6366f1;box-shadow:0 0 0 4px rgba(99,102,241,.14)}
        .gm-field[data-dirty="1"]{border-color:#f59e0b;background:color-mix(in srgb,#f59e0b 7%,var(--background))}
        .gm-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:38px;padding:0 16px;border-radius:11px;font-size:12.5px;font-weight:800;font-family:inherit;cursor:pointer;transition:transform .12s,box-shadow .15s,opacity .15s}
        .gm-btn:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 6px 16px rgba(79,70,229,.22)}
        .gm-btn:disabled{cursor:not-allowed}.gm-btn-sm{height:32px;padding:0 12px;font-size:12px}
        .gm-chip{height:34px;padding:0 14px;border-radius:999px;border:1.5px solid var(--border);background:var(--card);color:var(--muted-foreground);font-size:12.5px;font-weight:600;font-family:inherit;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:7px}
        .gm-chip:hover{border-color:#6366f1;color:#6366f1}.gm-chip[aria-pressed="true"]{border-color:#6366f1;background:rgba(99,102,241,.1);color:#6366f1;font-weight:800}
        .gm-chip b{font-size:11px;padding:1px 7px;border-radius:99px;background:var(--secondary);color:var(--foreground)}
        .gm-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1040px}
        .gm-table th{position:sticky;top:0;z-index:2;background:var(--secondary);font-size:10.5px;font-weight:800;color:var(--muted-foreground);text-transform:uppercase;letter-spacing:.07em;text-align:left;padding:12px 10px;border-bottom:1px solid var(--border)}
        .gm-table td{padding:9px 10px;border-bottom:1px solid var(--border);vertical-align:middle}
        .gm-table tbody tr{transition:background .12s}.gm-table tbody tr:hover{background:color-mix(in srgb,#6366f1 4%,transparent)}
        .gm-table tfoot td{background:var(--secondary);font-weight:900;font-size:12.5px;border-bottom:none;font-variant-numeric:tabular-nums}
        .gm-sticky{position:sticky;left:0;z-index:1;background:var(--card)}.gm-table th.gm-sticky{z-index:3;background:var(--secondary)}
        .gm-na{color:var(--muted-foreground);opacity:.45;text-align:center;font-size:13px}
        .gm-only-narrow{display:none}
        @media(max-width:900px){.gm-hide-narrow{display:none!important}.gm-only-narrow{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}}
      `}</style>

      {/* Header */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 14, flexWrap: 'wrap' }}>
        <div style={{ width: 42, height: 42, borderRadius: 13, background: 'linear-gradient(135deg,#4f46e5,#7c3aed)', display: 'flex', alignItems: 'center', justifyContent: 'center', boxShadow: '0 6px 18px rgba(79,70,229,.32)' }}><Target size={20} color="#fff" /></div>
        <div style={{ flex: 1, minWidth: 220 }}>
          <h1 style={{ margin: 0, fontSize: 22, fontWeight: 900, color: 'var(--foreground)', letterSpacing: '-.02em' }}>Metas</h1>
          <p style={{ margin: 0, fontSize: 13, color: 'var(--muted-foreground)' }}>Metas mensais — por closer, geral da empresa, ou por vertical · cada mês é independente</p>
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 6, background: 'var(--card)', border: '1px solid var(--border)', borderRadius: 14, padding: '5px 6px', boxShadow: '0 1px 2px rgba(0,0,0,.04)' }}>
          <button onClick={() => changeMonth(-1)} disabled={loadingMonth} aria-label="Mês anterior" data-v="mes-ant" style={{ width: 32, height: 32, borderRadius: 9, border: 'none', background: 'var(--secondary)', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'var(--foreground)' }}><ChevronLeft size={15} /></button>
          <span data-v="mes-label" style={{ fontSize: 13.5, fontWeight: 800, color: 'var(--foreground)', minWidth: 150, textAlign: 'center' }}>{loadingMonth ? '...' : monthLabel}</span>
          <button onClick={() => changeMonth(1)} disabled={loadingMonth} aria-label="Próximo mês" data-v="mes-prox" style={{ width: 32, height: 32, borderRadius: 9, border: 'none', background: 'var(--secondary)', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'var(--foreground)' }}><ChevronRight size={15} /></button>
        </div>
      </div>

      {/* Abas */}
      <div role="tablist" style={{ display: 'flex', gap: 4, padding: 4, background: 'var(--secondary)', borderRadius: 14, border: '1px solid var(--border)', width: 'fit-content', maxWidth: '100%', overflowX: 'auto' }}>
        {TABS.map(t => (
          <button key={t.key} role="tab" aria-selected={tab === t.key} data-v={`tab-${t.key}`} onClick={() => setTab(t.key)}
            style={{ height: 36, padding: '0 18px', borderRadius: 10, border: 'none', background: tab === t.key ? 'var(--card)' : 'transparent', boxShadow: tab === t.key ? '0 1px 4px rgba(0,0,0,.1)' : 'none', color: tab === t.key ? '#6366f1' : 'var(--muted-foreground)', fontSize: 13, fontWeight: tab === t.key ? 800 : 600, cursor: 'pointer', whiteSpace: 'nowrap', fontFamily: 'inherit', transition: 'all .15s' }}>{t.label}</button>
        ))}
      </div>

      {tab === 'geral' && <CompanyGoalsPanel mode="geral" month={currentMonth} initialGoals={companyGoals} key={`geral-${currentMonth}`} />}
      {tab === 'vertical' && <CompanyGoalsPanel mode="vertical" month={currentMonth} initialGoals={companyGoals} key={`vertical-${currentMonth}`} />}

      {tab === 'closers' && (<>
        {/* Barra de ferramentas */}
        <div style={{ display: 'flex', gap: 10, alignItems: 'center', flexWrap: 'wrap' }}>
          <div style={{ position: 'relative', flex: '1 1 240px', maxWidth: 340 }}>
            <Search size={15} style={{ position: 'absolute', left: 13, top: 12, color: 'var(--muted-foreground)' }} />
            <input data-v="busca" value={query} onChange={e => setQuery(e.target.value)} placeholder="Buscar closer…" aria-label="Buscar closer" className="gm-field" style={{ paddingLeft: 36 }} />
          </div>
          {([{ key: 'todos', label: 'Todos', n: visible.length }, { key: 'R1', label: 'Time R1', n: countTeam('R1') }, { key: 'OAO', label: 'Time OAO', n: countTeam('OAO') }] as const).map(t => (
            <button key={t.key} className="gm-chip" data-v={`time-${t.key}`} aria-pressed={filterTeam === t.key} onClick={() => setFilterTeam(t.key)}>{t.label} <b>{t.n}</b></button>
          ))}
          <div style={{ marginLeft: 'auto', display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
            <button className="gm-chip" data-v="repetir" onClick={fillFromPrevious} title="Completa só os campos vazios com os valores do mês anterior (você confere e salva)"><Copy size={13} />Preencher vazios com o mês anterior</button>
            <div style={{ display: 'inline-flex', padding: 3, background: 'var(--secondary)', borderRadius: 11, border: '1px solid var(--border)' }}>
              {([{ k: 'lista', Icon: LayoutList, l: 'Lista' }, { k: 'cards', Icon: LayoutGrid, l: 'Cartões' }] as const).map(o => (
                <button key={o.k} data-v={`view-${o.k}`} aria-pressed={view === o.k} onClick={() => setView(o.k)} style={{ height: 30, padding: '0 12px', borderRadius: 8, border: 'none', background: view === o.k ? 'var(--card)' : 'transparent', boxShadow: view === o.k ? '0 1px 3px rgba(0,0,0,.1)' : 'none', color: view === o.k ? '#6366f1' : 'var(--muted-foreground)', fontSize: 12, fontWeight: 800, cursor: 'pointer', display: 'inline-flex', alignItems: 'center', gap: 6, fontFamily: 'inherit' }}><o.Icon size={13} />{o.l}</button>
              ))}
            </div>
          </div>
        </div>
        {notice && <p data-v="aviso" style={{ margin: 0, fontSize: 12.5, fontWeight: 600, color: notice.startsWith('⚠') ? '#b45309' : '#15803d', padding: '9px 14px', borderRadius: 11, background: notice.startsWith('⚠') ? 'rgba(245,158,11,.1)' : 'rgba(34,197,94,.1)', border: `1px solid ${notice.startsWith('⚠') ? 'rgba(245,158,11,.3)' : 'rgba(34,197,94,.25)'}` }}>{notice}</p>}

        {(loadingMonth || !infoReady) ? (
          <div data-v="carregando" style={{ textAlign: 'center', padding: '56px', color: 'var(--muted-foreground)' }}><Loader2 size={28} className="gm-spin" style={{ margin: '0 auto' }} /><p style={{ marginTop: 12, fontSize: 13 }}>Carregando metas...</p></div>
        ) : filtered.length === 0 ? (
          <div data-v="vazio" style={{ textAlign: 'center', padding: '60px 24px', color: 'var(--muted-foreground)' }}><Target size={36} style={{ margin: '0 auto 12px', opacity: .3 }} /><p style={{ fontSize: 14 }}>Nenhum consultor encontrado.</p></div>
        ) : view === 'lista' ? (
          <div data-v="lista" className="gm-hide-narrow" style={{ background: 'var(--card)', border: '1px solid var(--border)', borderRadius: 18, overflow: 'auto', maxHeight: 'calc(100vh - 300px)', minHeight: 160, boxShadow: '0 1px 3px rgba(0,0,0,.04)' }}>
            <table className="gm-table">
              <thead><tr>
                <th className="gm-sticky" style={{ minWidth: 230 }}>Closer</th><th style={{ minWidth: 150 }}>🎯 Meta geral</th><th style={{ minWidth: 110 }}>🌟 Embaixadores</th>
                {ALL_VERTICALS.map(v => <th key={v} style={{ minWidth: 140 }}>{VERT_SHORT[v]}</th>)}<th style={{ width: 110 }} />
              </tr></thead>
              <tbody>
                {filtered.map((c, r) => { const d = drafts[c.id] ?? toDraft(c), b = base[c.id] ?? toDraft(c), team = TEAM_COLOR[c.team] ?? { bg: 'var(--secondary)', fg: 'var(--muted-foreground)', edge: 'var(--border)' }, vs = verticalsOf(c.team), st = statusOf(c.id), dirty = dirtyIds.includes(c.id)
                  return (
                    <tr key={`${c.id}-${currentMonth}`} data-v="goals-row" data-id={c.id} data-dirty={dirty ? '1' : '0'}>
                      <td className="gm-sticky" style={{ boxShadow: `inset 3px 0 0 ${team.edge}` }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: 11 }}>
                          <Avatar name={c.name} url={info[c.id]?.avatar_url ?? c.avatar_url} size={38} />
                          <div style={{ minWidth: 0 }}>
                            <p data-v="goals-name" style={{ margin: 0, fontSize: 13.5, fontWeight: 800, color: 'var(--foreground)', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{c.name}</p>
                            <span style={{ fontSize: 10.5, padding: '1px 8px', borderRadius: 6, background: team.bg, color: team.fg, fontWeight: 800 }}>Time {c.team ?? '—'}</span>
                          </div>
                        </div>
                      </td>
                      <td><MoneyField value={d.goalSales} dirty={d.goalSales !== b.goalSales} onChange={v => setDraft(c.id, x => ({ ...x, goalSales: v }))} cell={`${r}:geral`} label={`Meta geral de ${c.name}`} onNav={dir => nav(r, 'geral', dir)} /></td>
                      <td>{c.team === 'R1'
                        ? <input type="number" min="0" step="1" className="gm-field" data-cell={`${r}:emb`} aria-label={`Embaixadores de ${c.name}`} data-dirty={d.goalAmbassador !== b.goalAmbassador ? '1' : '0'} value={d.goalAmbassador || ''} placeholder="0"
                            onChange={e => { const n = Math.max(0, Math.floor(Number(e.target.value) || 0)); setDraft(c.id, x => ({ ...x, goalAmbassador: n })) }}
                            onKeyDown={e => { if (e.key === 'Enter' || e.key === 'ArrowDown') { e.preventDefault(); nav(r, 'emb', 1) } else if (e.key === 'ArrowUp') { e.preventDefault(); nav(r, 'emb', -1) } }} />
                        : <div className="gm-na">—</div>}</td>
                      {ALL_VERTICALS.map(v => <td key={v}>{vs.includes(v)
                        ? <MoneyField value={d.byV[v] || 0} dirty={(d.byV[v] || 0) !== (b.byV[v] || 0)} onChange={val => setDraft(c.id, x => ({ ...x, byV: { ...x.byV, [v]: val } }))} cell={`${r}:${v}`} label={`${v} de ${c.name}`} onNav={dir => nav(r, v, dir)} />
                        : <div className="gm-na">—</div>}</td>)}
                      <td style={{ textAlign: 'right' }}>
                        <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: 3 }}>
                          <SaveBtn id={c.id} />
                          {st?.status === 'error' && <span data-v="row-erro" title={st.msg} style={{ fontSize: 10.5, color: '#ef4444', fontWeight: 700, display: 'inline-flex', gap: 3, alignItems: 'center' }}><AlertTriangle size={11} />{st.msg}</span>}
                        </div>
                      </td>
                    </tr>)
                })}
              </tbody>
              <tfoot><tr data-v="totais">
                <td className="gm-sticky" style={{ background: 'var(--secondary)' }}>Total ({filtered.length}) · {totals.filled} com meta</td>
                <td data-v="total-geral">{fmtShort(totals.goalSales)}</td><td data-v="total-emb">{totals.goalAmbassador || '—'}</td>
                {ALL_VERTICALS.map(v => <td key={v} data-v={`total-${v}`}>{totals.byV[v] ? fmtShort(totals.byV[v]) : '—'}</td>)}<td />
              </tr></tfoot>
            </table>
          </div>
        ) : null}

        {!(loadingMonth || !infoReady) && filtered.length > 0 && (
          <div data-v="cards" className={view === 'lista' ? 'gm-only-narrow' : ''} style={{ display: view === 'lista' ? undefined : 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(360px,1fr))', gap: 16 }}>
            {filtered.map((c, r) => { const d = drafts[c.id] ?? toDraft(c), b = base[c.id] ?? toDraft(c), team = TEAM_COLOR[c.team] ?? { bg: 'var(--secondary)', fg: 'var(--muted-foreground)', edge: 'var(--border)' }, vs = verticalsOf(c.team), st = statusOf(c.id)
              return (
                <div key={`${c.id}-${currentMonth}`} data-v="goals-card" data-id={c.id} style={{ background: 'var(--card)', border: '1px solid var(--border)', borderRadius: 20, overflow: 'hidden', boxShadow: '0 1px 3px rgba(0,0,0,.04)' }}>
                  <div style={{ padding: '18px 20px', display: 'flex', alignItems: 'center', gap: 14, background: `linear-gradient(135deg, ${team.bg}, transparent)`, borderBottom: '1px solid var(--border)' }}>
                    <Avatar name={c.name} url={info[c.id]?.avatar_url ?? c.avatar_url} size={56} />
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <p style={{ margin: 0, fontSize: 15, fontWeight: 900, color: 'var(--foreground)' }}>{c.name}</p>
                      <span style={{ fontSize: 11, padding: '1px 9px', borderRadius: 6, background: team.bg, color: team.fg, fontWeight: 800 }}>Time {c.team ?? '—'}</span>
                    </div>
                    <SaveBtn id={c.id} />
                  </div>
                  <div style={{ padding: '16px 20px', display: 'flex', flexDirection: 'column', gap: 12 }}>
                    {st?.status === 'error' && <p data-v="row-erro" style={{ margin: 0, fontSize: 12, color: '#ef4444', padding: '8px 12px', background: 'rgba(239,68,68,.06)', border: '1px solid rgba(239,68,68,.2)', borderRadius: 10 }}>⚠ {st.msg}</p>}
                    <div><label className="gm-label">🎯 Meta geral de vendas</label><MoneyField value={d.goalSales} dirty={d.goalSales !== b.goalSales} onChange={v => setDraft(c.id, x => ({ ...x, goalSales: v }))} cell={`c${r}:geral`} label={`Meta geral de ${c.name}`} /></div>
                    {c.team === 'R1' && <div><label className="gm-label">🌟 Meta de embaixadores</label><input type="number" min="0" step="1" className="gm-field" aria-label={`Embaixadores de ${c.name}`} data-dirty={d.goalAmbassador !== b.goalAmbassador ? '1' : '0'} value={d.goalAmbassador || ''} placeholder="0" onChange={e => { const n = Math.max(0, Math.floor(Number(e.target.value) || 0)); setDraft(c.id, x => ({ ...x, goalAmbassador: n })) }} /><p style={{ margin: '4px 0 0', fontSize: 11, color: 'var(--muted-foreground)' }}>Número de embaixadores a certificar no mês</p></div>}
                    {vs.length > 0 && <div><label className="gm-label">📊 Meta por vertical</label><div style={{ display: 'flex', flexDirection: 'column', gap: 9 }}>{vs.map(v => (
                      <div key={v} style={{ display: 'grid', gridTemplateColumns: '1fr 1.2fr', alignItems: 'center', gap: 12 }}><span style={{ fontSize: 13, fontWeight: 700, color: 'var(--foreground)' }}>{v}</span><MoneyField value={d.byV[v] || 0} dirty={(d.byV[v] || 0) !== (b.byV[v] || 0)} onChange={val => setDraft(c.id, x => ({ ...x, byV: { ...x.byV, [v]: val } }))} cell={`c${r}:${v}`} label={`${v} de ${c.name}`} /></div>))}</div></div>}
                  </div>
                </div>)
            })}
          </div>
        )}

        {hiddenCount > 0 && !(loadingMonth || !infoReady) && <p data-v="ocultos" style={{ margin: 0, fontSize: 11.5, color: 'var(--muted-foreground)', textAlign: 'center' }}>{hiddenCount} usuário{hiddenCount > 1 ? 's' : ''} inativo{hiddenCount > 1 ? 's' : ''} ou excluído{hiddenCount > 1 ? 's' : ''} não aparece{hiddenCount > 1 ? 'm' : ''} aqui (as metas já gravadas continuam valendo).</p>}

        {/* Barra de salvar (aparece quando há alteração) */}
        {dirtyIds.length > 0 && (
          <div data-v="barra-salvar" style={{ position: 'fixed', left: '50%', bottom: 22, transform: 'translateX(-50%)', zIndex: 60, display: 'flex', alignItems: 'center', gap: 14, padding: '10px 12px 10px 20px', borderRadius: 16, background: 'var(--foreground)', color: 'var(--background)', boxShadow: '0 16px 40px rgba(0,0,0,.35)', maxWidth: 'calc(100vw - 24px)' }}>
            <span data-v="barra-info" style={{ fontSize: 13, fontWeight: 700 }}>{dirtyIds.length} {dirtyIds.length === 1 ? 'linha alterada' : 'linhas alteradas'} · não salvas</span>
            <button className="gm-btn gm-btn-sm" data-v="descartar" onClick={discardAll} disabled={bulk} style={{ background: 'transparent', color: 'inherit', border: '1px solid rgba(255,255,255,.3)' }}><RotateCcw size={12} />Descartar</button>
            <button className="gm-btn gm-btn-sm" data-v="salvar-todas" onClick={saveAll} disabled={bulk} style={{ background: 'linear-gradient(135deg,#6366f1,#8b5cf6)', color: '#fff', border: 'none' }}>{bulk ? <Loader2 size={12} className="gm-spin" /> : <Save size={12} />}{bulk ? 'Salvando…' : 'Salvar todas'}</button>
          </div>
        )}
      </>)}
    </div>
  )

}
